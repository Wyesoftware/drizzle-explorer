{
  "name": "drizzle-explorer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DBeaver-like desktop database explorer built on Bun, drizzle-orm, shadcn (Base UI) and AG Grid",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:ui": "vite",
    "dev:app": "DRIZZLE_EXPLORER_DEV_URL=http://localhost:5173 bun run src/main/index.ts",
    "build": "bun run scripts/build.ts --sign",
    "build:unsigned": "bun run scripts/build.ts",
    "icon": "bun run scripts/make-icon.ts",
    "build:ui": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/ui/tsconfig.json --noEmit",
    "test": "bun test",
    "serve": "bun run scripts/serve.ts",
    "serve:dev": "DRIZZLE_EXPLORER_DEV_URL=http://localhost:5173 bun run scripts/serve.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "codemirror": "6.0.2",
    "drizzle-orm": "1.0.0-rc.5",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.15.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.23.0",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "sql-formatter": "15.9.0",
    "tw-animate-css": "1.4.0",
    "webview-bun": "2.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bun-types": "1.4.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
